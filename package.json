{
  "name": "open-news-feed",
  "version": "1.0.0",
  "description": "Meridian — an open-source world news feed with live translation and AI briefs. Aggregates dozens of open sources, sorted by freshness.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --max-old-space-size=160 --max-semi-space-size=8 --disable-warning=ExperimentalWarning server.js",
    "dev": "node --watch server.js",
    "test": "npm run test:unit && npm run test:int && npm run test:e2e",
    "test:unit": "LOG_SILENT=1 node --test --disable-warning=ExperimentalWarning 'test/unit/**/*.test.js'",
    "test:int": "LOG_SILENT=1 node --test --disable-warning=ExperimentalWarning 'test/integration/**/*.test.js'",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "verify:feeds": "node scripts/verify-feeds.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "news",
    "rss",
    "aggregator",
    "feed",
    "open-source"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DmitriyBagrov92/open-news-feed.git"
  },
  "homepage": "https://github.com/DmitriyBagrov92/open-news-feed#readme",
  "bugs": {
    "url": "https://github.com/DmitriyBagrov92/open-news-feed/issues"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "compression": "^1.8.0",
    "express": "^4.21.2",
    "linkedom": "^0.18.5",
    "motion": "^12.42.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
