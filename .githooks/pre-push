#!/bin/bash
# Pre-push gate — opt in once with:  git config core.hooksPath .githooks
# Web/server changes run `npm test`; iOS changes (or the web modules the iOS golden vectors come
# from) run ios/scripts/test.sh. A red gate blocks the push.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
changed=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    range="${base:+$base..}$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  changed+="$(git diff --name-only "$range")"$'\n'
done
web="$(printf '%s' "$changed" | grep -vE '^ios/' | grep -E '^(server\.js|package(-lock)?\.json|lib/|public/|config/|test/)' || true)"
ios="$(printf '%s' "$changed" | grep -E '^ios/|^public/js/(ai|recommend|time|cards|country|prefs|i18n)\.js$' || true)"
if [ -n "$web" ]; then (cd "$ROOT" && npm test); fi
if [ -n "$ios" ]; then "$ROOT/ios/scripts/test.sh"; fi
