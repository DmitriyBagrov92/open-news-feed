# Dependencies
node_modules/

# Secrets — API keys live here, never commit them
.env
.env.*
!.env.example
secrets/

# Logs & runtime
*.log
npm-debug.log*
.cache/
# Local comments database
data/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Test runner output (snapshots under test/e2e/__snapshots__ ARE committed)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# iOS app (ios/) — the Xcode project is generated by XcodeGen from ios/project.yml
ios/*.xcodeproj/
ios/build/
xcuserdata/
*.xcuserstate
DerivedData/
*.xcresult
ios/.build/
ios/.spm-cache/
ios/screenshots/
# the App Store newsroom's photographs — fetched by ios/scripts/newsroom.mjs --images
ios/Tests/Newsroom/images/
